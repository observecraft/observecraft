                  "style": {
                    "palette": "classic",
                    "order_by": "values"
                  },
                  "display_type": "bars"
                }
              ],
              "yaxis": {
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "id": 11,
            "definition": {

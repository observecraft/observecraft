          {
            "id": 15,
            "definition": {
              "type": "toplist",
              "title": "Rows exported by user",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "query1",
                      "search": {
                        "query": "source:salesforce @evt.name:Report"
                      },
                      "indexes": [
                        "*"

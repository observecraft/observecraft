          "color": "blue",
          "light": true,
          "compact": false,
          "widgets": [
            {
              "id": "salesforce-3",
              "definition": {
                "type": "integration",
                "title": "API requests left today",
                "original": {
                  "type": "query_value",
                  "title": "API requests left today",
                  "title_size": "16",
                  "title_align": "left",
                  "requests": [
                    {
                      "response_format": "scalar",
                      "queries": [
                        {
                          "data_source": "metrics",
                          "name": "query1",
                          "query": "avg:salesforce.limits.remaining{limit_name:DailyApiRequests}",
                          "aggregator": "last"
                        }
                      ],
                      "formulas": [
                        {
                          "formula": "query1"
                        }
                      ],
                      "conditional_formats": [
                        {
                          "comparator": ">=",
                          "value": 0,
                          "palette": "white_on_gray"
                        }
                      ]
                    }
                  ],
                  "autoscale": true,
                  "precision": 0
                }
              },
              "layout": {

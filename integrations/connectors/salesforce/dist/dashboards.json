          "compact": false,
          "showTitle": false,
          "widgets": [
            {
              "id": "salesforce-2",
              "definition": {
                "type": "note",
                "content": "**Salesforce** is a CRM platform. This dashboard reads an org's Event Monitoring log files (source `salesforce`: logins and their failures, API calls, reports run and exported, pages viewed) and its limits (`salesforce.limits.*`: daily API requests, storage).\n\nConnect an org in [Integrations → Salesforce](/integrations/connectors/salesforce) with an External Client App using the client credentials flow.",
                "background": "white",
                "align": "left",
                "fontSize": "sm"
              },
              "layout": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 4
              }
            }
          ]
        },
        "layout": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 6
        }
      },
      {
        "id": "salesforce-9",

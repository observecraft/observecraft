{
  "title": "Fastly - Overview",
  "description": "Fastly services' traffic, cache efficiency, errors and origin load per minute, and their request logs.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Fastly** is an edge cloud: CDN, security and compute at its POPs. This dashboard shows each service's requests, hit ratio, bandwidth, status codes, errors and origin fetches per minute (`fastly.*`, from the historical stats API), and the request logs Fastly streams (source `fastly`).\n\nConnect an account in [Integrations → Fastly](/integrations/connectors/fastly) with a global:read API token.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },

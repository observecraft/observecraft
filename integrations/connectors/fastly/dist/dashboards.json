          "widgets": [
            {
              "id": "fastly-18",
              "definition": {
                "type": "integration",
                "title": "Requests by status code",
                "original": {
                  "type": "timeseries",
                  "title": "Requests by status code",
                  "title_size": "16",
                  "title_align": "left",
                  "show_legend": true,
                  "legend_layout": "auto",
                  "requests": [
                    {
                      "response_format": "timeseries",
                      "queries": [
                        {
                          "data_source": "logs",
                          "name": "query1",
                          "search": {
                            "query": "source:fastly"
                          },
                          "indexes": [
                            "*"
                          ],
                          "compute": {
                            "aggregation": "count"
                          },
                          "group_by": [
                            {
                              "facet": "@http.status_code",
                              "limit": 10,
                              "sort": {
                                "aggregation": "count",
                                "order": "desc"
                              }
                            }
                          ],
                          "storage": "hot"
                        }
                      ],
                      "formulas": [
                        {
                          "formula": "query1"
                        }
                      ],
                      "style": {
                        "palette": "classic",
                        "order_by": "values"

{
  "title": "Zoom Activity Logs - Overview",
  "description": "A Zoom account's sign-in and sign-out activity and its admin operation logs.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Zoom** is a video meeting and collaboration platform. This dashboard reads its Reports API (source `zoom`): who signed in and out from which clients and IPs, and what the account's admins changed (users, settings, roles, recordings).\n\nConnect an account in [Integrations → Zoom Activity Logs](/integrations/connectors/zoom-activity-logs) with a Server-to-Server OAuth app.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {

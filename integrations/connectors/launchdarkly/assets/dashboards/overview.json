{
  "title": "LaunchDarkly - Overview",
  "description": "A LaunchDarkly account's flag, segment and environment changes as events.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**LaunchDarkly** manages feature flags: who sees which feature, in which environment. This dashboard shows its change history (events of source `launchdarkly`, tagged `env`, `project`, `flag` and `kind`), so a flag turned on can be lined up with the errors and latency that followed.\n\nConnect an account in [Integrations → LaunchDarkly](/integrations/connectors/launchdarkly) with a Reader token.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "id": 10,
      "definition": {
        "type": "group",
        "title": "Changes",
        "background_color": "blue",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 3,
            "definition": {
              "type": "query_value",
              "title": "Changes",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "events",
                      "name": "query1",
                      "search": {
                        "query": "source:launchdarkly"
                      },
                      "indexes": [
                        "*"
                      ],
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [],
                      "storage": "hot"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_gray"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "id": 4,
            "definition": {
              "type": "query_value",
              "title": "Flags changed",
              "title_size": "16",
              "title_align": "left",

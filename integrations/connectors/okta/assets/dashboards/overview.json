{
  "title": "Okta - Overview",
  "description": "An Okta org's System Log: sign-ins and their outcomes, MFA, administrator changes and policy decisions.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Okta** is an identity provider: single sign-on, MFA and user lifecycle for an organization's applications. This dashboard reads the org's System Log (source `okta`): who signed in from where, failed and denied attempts, MFA challenges, privilege grants and policy decisions.\n\nConnect an org in [Integrations → Okta](/integrations/connectors/okta): ObserveCraft reads its System Log API every minute with a read-only administrator's token.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },

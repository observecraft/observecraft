          "compact": false,
          "showTitle": false,
          "widgets": [
            {
              "id": "1password-2",
              "definition": {
                "type": "note",
                "content": "**1Password** stores a team's passwords, keys and other secrets in shared vaults. This dashboard reads its Events API (source `1password`): sign-in attempts and their failures, who revealed, copied or filled which items, and the administrators' changes to vaults, groups and users.\n\nConnect an account in [Integrations → 1Password](/integrations/connectors/1password) with an Events Reporting token.",
                "background": "white",
                "align": "left",
                "fontSize": "sm"
              },
              "layout": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 4
              }
            }
          ]
        },
        "layout": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 6
        }
      },

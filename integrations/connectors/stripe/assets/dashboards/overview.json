                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "query1",
                      "search": {
                        "query": "source:stripe @evt.name:(charge.failed OR payment_intent.payment_failed)"
                      },
                      "indexes": [
                        "*"
                      ],
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [],
                      "storage": "hot"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "conditional_formats": [
                    {

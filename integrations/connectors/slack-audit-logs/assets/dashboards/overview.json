{
  "title": "Slack Audit Logs - Overview",
  "description": "An Enterprise Slack organization's audit log: sign-ins, files, channels, apps and admin changes.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Slack** is a messaging platform; Enterprise organizations keep an audit log of what their members and admins do. This dashboard reads it (source `slack`): sign-ins and failures, downloaded and shared files, channels created and archived, apps installed, and admin settings changed. Message contents are never part of it.\n\nConnect an organization in [Integrations → Slack Audit Logs](/integrations/connectors/slack-audit-logs) with an org-installed app's `auditlogs:read` token.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "id": 9,

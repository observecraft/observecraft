    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Twilio** sends and receives SMS, WhatsApp messages and calls through an API. This dashboard reads the account (source `twilio`): the Debugger's alerts by error code, messages that failed or weren't delivered, call summaries, and account changes such as new API keys. Message bodies are never collected. Daily spend is in Cloud Cost Management (provider `twilio`).\n\nConnect an account in [Integrations → Twilio](/integrations/connectors/twilio) with a Standard API key.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },

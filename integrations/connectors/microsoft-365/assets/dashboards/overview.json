{
  "title": "Microsoft 365 - Overview",
  "description": "A Microsoft 365 tenant's unified audit log: files, sharing, mail, Teams, sign-ins and admin actions.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Microsoft 365** is Microsoft's productivity suite: Exchange, SharePoint, OneDrive, Teams. This dashboard reads its unified audit log (source `microsoft-365`, service the workload): files downloaded and shared, mailbox access, Teams changes, sign-ins and administrator actions.\n\nConnect a tenant in [Integrations → Microsoft 365](/integrations/connectors/microsoft-365) with an app registration allowed ActivityFeed.Read.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },

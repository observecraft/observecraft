          "widgets": [
            {
              "id": "akamai-2",
              "definition": {
                "type": "note",
                "content": "**Akamai App & API Protector** (and Kona Site Defender) filter attacks at Akamai's edge. This dashboard reads their security events from the SIEM API (source `akamai`, service `appsec`): which rules fired, what was denied, from which clients and countries, against which hosts and paths.\n\nConnect configurations in [Integrations → Akamai Application Security](/integrations/connectors/akamai) with an EdgeGrid API client allowed the SIEM API.",
                "background": "white",
                "align": "left",
                "fontSize": "sm"
              },
              "layout": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 4
              }
            }
          ]
        },
        "layout": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 6
        }

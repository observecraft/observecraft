{
  "title": "Akamai Application Security - Overview",
  "description": "Akamai App & API Protector security events: attacks by rule, action, client and target.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Akamai App & API Protector** (and Kona Site Defender) filter attacks at Akamai's edge. This dashboard reads their security events from the SIEM API (source `akamai`, service `appsec`): which rules fired, what was denied, from which clients and countries, against which hosts and paths.\n\nConnect configurations in [Integrations → Akamai Application Security](/integrations/connectors/akamai) with an EdgeGrid API client allowed the SIEM API.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "id": 13,
      "definition": {
        "type": "group",
        "title": "Attacks",
        "background_color": "blue",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 3,
            "definition": {
              "type": "query_value",
              "title": "Security events",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "query1",
                      "search": {
                        "query": "source:akamai service:appsec"
                      },
                      "indexes": [
                        "*"
                      ],
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [],
                      "storage": "hot"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_gray"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "id": 4,

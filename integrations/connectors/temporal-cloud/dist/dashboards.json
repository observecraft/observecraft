[
  {
    "id": "temporal-cloud-overview",
    "title": "Temporal Cloud Overview",
    "description": "Requests, errors, latency, workflow outcomes, task queue backlogs and limits of a Temporal Cloud account's namespaces.",
    "kind": "integration",
    "logo": "temporal-cloud",
    "teams": [],
    "layoutType": "grid",
    "templateVariables": [
      {
        "name": "temporal_namespace",
        "prefix": "temporal_namespace",
        "default": "*"
      },
      {
        "name": "region",
        "prefix": "region",
        "default": "*"
      }
    ],
    "widgets": [
      {
        "id": "temporal-cloud-2",
        "definition": {
          "type": "group",
          "title": "",
          "color": "blue",
          "compact": false,
          "widgets": [
            {
              "id": "temporal-cloud-1",
              "definition": {
                "type": "note",
                "content": "**Temporal Cloud** runs Temporal's workflow service as a managed service. This dashboard shows the namespaces of the connected account from Temporal Cloud's OpenMetrics endpoint: frontend requests, errors and latency, workflow outcomes, task queue backlogs and the namespace's limits. Values are per-minute aggregates: rates are per second, latencies in seconds. Connect an account in Integrations → Temporal Cloud.",
                "background": "white",
                "align": "left",
                "fontSize": "sm"
              },
              "layout": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 4
              }
            }
          ]
        },
        "layout": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 7
        }
      },

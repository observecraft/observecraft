{
  "title": "Temporal Cloud Overview",
  "description": "Requests, errors, latency, workflow outcomes, task queue backlogs and limits of a Temporal Cloud account's namespaces.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "temporal_namespace",
      "prefix": "temporal_namespace",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "region",
      "prefix": "region",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "id": 2,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 1,
            "definition": {
              "type": "note",
              "content": "**Temporal Cloud** runs Temporal's workflow service as a managed service. This dashboard shows the namespaces of the connected account from Temporal Cloud's OpenMetrics endpoint: frontend requests, errors and latency, workflow outcomes, task queue backlogs and the namespace's limits. Values are per-minute aggregates: rates are per second, latencies in seconds. Connect an account in Integrations \u2192 Temporal Cloud.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {

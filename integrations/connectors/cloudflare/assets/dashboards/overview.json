    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Cloudflare** serves and protects websites at its edge: CDN, WAF, DNS and Workers. This dashboard shows each zone's requests, cache hit ratio, bandwidth, threats and DNS queries per minute (`cloudflare.*`, from the GraphQL Analytics API), Workers invocations, and the HTTP request logs Logpush sends (source `cloudflare`).\n\nConnect an account in [Integrations → Cloudflare](/integrations/connectors/cloudflare) with an API token that reads zones and analytics.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },

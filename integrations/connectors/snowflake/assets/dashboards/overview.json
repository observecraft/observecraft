  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**Snowflake** is a cloud data warehouse. This dashboard reads its ACCOUNT_USAGE views: each warehouse's credits per hour and the account's storage (`snowflake.*`), the query history (slow and failed queries, bytes scanned) and login attempts (source `snowflake`).\n\nConnect an account in [Integrations → Snowflake](/integrations/connectors/snowflake) with a key-pair service user.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "id": 9,
      "definition": {
        "type": "group",
        "title": "Credits and storage",
        "background_color": "blue",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 3,
            "definition": {
              "type": "query_value",
              "title": "Credits (period)",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:snowflake.billing.warehouse.total_credit.sum{*}",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_gray"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2

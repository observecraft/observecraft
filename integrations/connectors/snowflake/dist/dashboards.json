            {
              "id": "snowflake-2",
              "definition": {
                "type": "note",
                "content": "**Snowflake** is a cloud data warehouse. This dashboard reads its ACCOUNT_USAGE views: each warehouse's credits per hour and the account's storage (`snowflake.*`), the query history (slow and failed queries, bytes scanned) and login attempts (source `snowflake`).\n\nConnect an account in [Integrations → Snowflake](/integrations/connectors/snowflake) with a key-pair service user.",
                "background": "white",
                "align": "left",
                "fontSize": "sm"
              },
              "layout": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 4
              }
            }

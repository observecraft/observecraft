{
  "title": "GitHub - Overview",
  "description": "A GitHub organization's audit log and its open code scanning, Dependabot and secret scanning alerts.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "",
        "background_color": "vivid_blue",
        "show_title": false,
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2,
            "definition": {
              "type": "note",
              "content": "**GitHub** hosts an organization's repositories, reviews and Actions. This dashboard reads its audit log (source `github`): repositories created, made public or deleted, members and permissions changed, branch protections removed, tokens and apps; and the open security alerts of its repositories (`github.*.alerts.open`).\n\nConnect an organization in [Integrations → GitHub](/integrations/connectors/github) with a GitHub App.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },

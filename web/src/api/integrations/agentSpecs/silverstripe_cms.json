{"name":"silverstripe_cms.yaml","options":[{"name":"instances","description":"Every instance is scheduled independently of the others.","multiple":true,"options":[{"name":"SILVERSTRIPE_DATABASE_TYPE","description":"Silverstripe Database Type (MySQL or PostgreSQL).","required":true,"value":{"type":"string","example":"<DATABASE_TYPE>"}},{"name":"SILVERSTRIPE_DATABASE_NAME","description":"Silverstripe Database Name.","required":true,"value":{"type":"string","example":"<DATABASE_NAME>"}},{"name":"SILVERSTRIPE_DATABASE_SERVER_IP","description":"Silverstripe Database Server IP.","required":true,"value":{"type":"string","example":"<IP_ADDRESS>"}},{"name":"SILVERSTRIPE_DATABASE_PORT","description":"Silverstripe Database Port.","required":true,"value":{"type":"integer","minimum":0,"maximum":65535,"example":5432}},{"name":"SILVERSTRIPE_DATABASE_USERNAME","description":"Silverstripe Database Username.","required":true,"value":{"type":"string","example":"<USERNAME>"}},{"name":"SILVERSTRIPE_DATABASE_PASSWORD","description":"Silverstripe Database Password.","required":true,"secret":true,"value":{"type":"string","example":"<PASSWORD>"}},{"name":"tags","description":"A list of tags to attach to every metric and service check emitted by this instance.\n\nLearn more about tagging at https://docs.datadoghq.com/tagging","value":{"example":["<KEY_1>:<VALUE_1>","<KEY_2>:<VALUE_2>"],"type":"array","items":{"type":"string"}}},{"name":"min_collection_interval","description":"This changes the collection interval of the check. For more information, see:\nhttps://docs.datadoghq.com/developers/write_agent_check/#collection-interval","required":true,"value":{"example":15,"type":"number","maximum":14400,"minimum":1}}]}]}

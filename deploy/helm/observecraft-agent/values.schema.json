{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ObserveCraft Agent chart values",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "pattern": "^(https?://[^\\s]+)?$"
    },
    "apiKey": {
      "type": "string",
      "pattern": "^(ocik_[A-Za-z0-9_-]+)?$",
      "description": "Ingest API key (ocik_\u2026)"
    },
    "existingSecret": {
      "type": "string"
    },
    "clusterName": {
      "type": "string",
      "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]*)?$"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "node": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "logs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "excludeNamespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "kubeletMetrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            }
          }
        },
        "hostMetrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            }
          }
        },
        "otlp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "datadog": {
          "type": "object",
          "properties": {
            "traces": {
              "type": "boolean"
            },
            "dogstatsd": {
              "type": "boolean"
            }
          }
        },
        "hostPorts": {
          "type": "boolean"
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            }
          }
        },
        "dataHostPath": {
          "type": "string",
          "pattern": "^/"
        },
        "resources": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "extraConfig": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "cluster": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metricsInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "objectsInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "events": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "extraConfig": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        }
      }
    }
  }
}
<!-- Users as in the Helm chart: `observecraft` for the server (per-org quota keyed by the org it
     sends as quota_key) and `observecraft_ingest` (async inserts) for the collector. `default` has no
     password, for tests and `make storage-report`: the ports are published on loopback only. -->
<clickhouse>
  <users>
    <default>
      <networks replace="replace"><ip>::/0</ip></networks>
      <access_management>1</access_management>
      <profile>tests</profile>
    </default>
    <observecraft>
      <password>observecraft</password>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>per_org</quota>
      <access_management>1</access_management>
    </observecraft>
    <observecraft_ingest>
      <password>observecraft</password>
      <networks><ip>::/0</ip></networks>
      <profile>ingest</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT INSERT, SELECT, SHOW ON oc.*</query>
        <query>GRANT INSERT, SELECT, SHOW ON otel.*</query>
      </grants>
    </observecraft_ingest>
  </users>
  <profiles>
    <!-- The tests' user: an insert returns once every shard has its rows, and reads and inserts
         go to the first replica of each shard, so a test reads what it just wrote. -->
    <tests>
      <insert_distributed_sync>1</insert_distributed_sync>
      <load_balancing>in_order</load_balancing>
    </tests>
    <ingest>
      <profile>default</profile>
      <async_insert>1</async_insert>
      <wait_for_async_insert>1</wait_for_async_insert>
      <async_insert_use_adaptive_busy_timeout>0</async_insert_use_adaptive_busy_timeout>
      <async_insert_busy_timeout_ms>1000</async_insert_busy_timeout_ms>
    </ingest>
  </profiles>
  <quotas>
    <per_org>
      <keyed/>
      <interval>
        <duration>60</duration>
        <query_selects>3000</query_selects>
        <execution_time>900</execution_time>
        <read_rows>0</read_rows>
      </interval>
    </per_org>
  </quotas>
</clickhouse>

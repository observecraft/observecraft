        ],
        "target": "gitlab.target_details",
        "preserveSource": true,
        "overrideOnConflict": false,
        "sourceType": "attribute",
        "targetType": "attribute"
      },
      {
        "type": "category-processor",
        "name": "Categorise the audit event",
        "enabled": true,
        "categories": [
          {
            "filter": {
              "query": "@evt.name:(*login* OR *authentication* OR *two_factor* OR *otp* OR *webauthn* OR *passkey* OR user_access_locked OR user_access_unlocked OR password_reset_* OR user_password_updated)"
            },
            "name": "authentication"
          },
          {
            "filter": {
              "query": "@gitlab.details.failed_login:*"
            },
            "name": "authentication"
          },
          {
            "filter": {
              "query": "@evt.name:(*token*)"
            },
            "name": "token"
          },
          {
            "filter": {
              "query": "@evt.name:(*merge_request* OR *approval* OR *approver*)"
            },
            "name": "merge_request"
          },
          {
            "filter": {
              "query": "@evt.name:(member_* OR *_member_* OR *_members_* OR *access_level* OR *user_access_* OR *saml_group_link* OR user_access_added OR user_access_removed)"
            },
            "name": "membership"
          },
          {
            "filter": {
              "query": "@evt.name:(*oauth_application* OR user_authorized_* OR user_rejected_*)"
            },
            "name": "authorization"
          },
          {
            "filter": {
              "query": "@evt.name:(user_* OR *_user_* OR registration_*)"
            },
            "name": "user_management"
          },
          {
            "filter": {
              "query": "@evt.name:(ci_* OR *runner* OR *variable* OR *pipeline* OR *environment* OR *deploy_key* OR *deploy_token*)"
            },
            "name": "ci_cd"
          },
          {
            "filter": {
              "query": "@evt.name:(*protected_branch* OR *protected_tag* OR *push_rule* OR *repository* OR *branch*)"
            },
            "name": "repository"
          },
          {
            "filter": {
              "query": "@evt.name:(project_*)"
            },
            "name": "project"
          },
          {
            "filter": {
              "query": "@evt.name:(group_*)"
            },
            "name": "group"
          },
          {
            "filter": {
              "query": "@evt.name:(*audit* OR *compliance* OR *streaming_destination*)"
            },
            "name": "compliance"
          },
          {

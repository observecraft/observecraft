{
 "title": "Host Overview",
 "description": "CPU, memory, load, disk, network and processes for every host reporting host metrics.",
 "kind": "integration",
 "logo": "linux",
 "teams": [],
 "layoutType": "grid",
 "templateVariables": [
  {
   "name": "host",
   "prefix": "host",
   "default": "*"
  },
  {
   "name": "env",
   "prefix": "env",
   "default": "*"
  },
  {
   "name": "team",
   "prefix": "team",
   "default": "*"
  }
 ],
 "widgets": [
  {
   "id": "w1",
   "definition": {
    "type": "note",
    "content": "**Host Overview** \u2014 reported by the OpenTelemetry Collector `hostmetrics` receiver (or any agent sending the same metrics).\n\nCPU and memory are shown in %, network as bytes per second. Use the template variables above to scope to a host, environment or team.",
    "background": "blue",
    "align": "left",
    "fontSize": "md"
   },
   "layout": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 2
   }
  },
  {
   "id": "w2",
   "definition": {
    "type": "query_value",
    "title": "CPU user",
    "request": {
     "query": "avg:system.cpu.user{$host,$env,$team}"
    },
    "aggregator": "avg",
    "precision": 1,
    "formats": [
     {
      "comparator": ">",
      "value": 80,
      "palette": "red"
     },
     {
      "comparator": ">",
      "value": 60,
      "palette": "yellow"
     },
     {
      "comparator": "<=",
      "value": 60,
      "palette": "green"
     }
    ],
    "unit": "%"
   },
   "layout": {
    "x": 0,
    "y": 2,
    "w": 3,
    "h": 4
   }
  },
  {
   "id": "w3",
   "definition": {
    "type": "query_value",
    "title": "Memory used",
    "request": {
     "query": "avg:system.mem.pct_used{$host,$env,$team}"
    },
    "aggregator": "avg",
    "precision": 1,
    "formats": [
     {
      "comparator": ">",
      "value": 90,
      "palette": "red"
     },
     {
      "comparator": ">",
      "value": 75,
      "palette": "yellow"
     },
     {
      "comparator": "<=",
      "value": 75,
      "palette": "green"
     }
    ],
    "unit": "%"
   },
   "layout": {
    "x": 3,
    "y": 2,
    "w": 3,
    "h": 4
   }
  },
  {
   "id": "w4",
   "definition": {
    "type": "query_value",
    "title": "Load (1m)",
    "request": {
     "query": "avg:system.load.1{$host,$env,$team}"
    },
    "aggregator": "avg",
    "precision": 2,
    "formats": [
     {
      "comparator": ">=",
      "value": 0,
      "palette": "blue"
     }
    ]
   },
   "layout": {
    "x": 6,
    "y": 2,
    "w": 3,
    "h": 4
   }
  },
  {
   "id": "w5",
   "definition": {
    "type": "query_value",
    "title": "Disk used",
    "request": {
     "query": "max:system.disk.in_use{$host,$env,$team}"
    },
    "aggregator": "avg",
    "precision": 1,
    "formats": [
     {
      "comparator": ">",
      "value": 90,
      "palette": "red"
     },
     {
      "comparator": ">",
      "value": 80,
      "palette": "yellow"
     },
     {
      "comparator": "<=",
      "value": 80,
      "palette": "green"
     }
    ],
    "unit": "%"
   },
   "layout": {
    "x": 9,
    "y": 2,
    "w": 3,
    "h": 4
   }
  },
  {
   "id": "w6",
   "definition": {
    "type": "timeseries",
    "title": "CPU user % by host",
    "requests": [
     {
      "query": "avg:system.cpu.user{$host,$env,$team} by {host}"
     }
    ],
    "display": "line"
   },
   "layout": {
    "x": 0,
    "y": 6,
    "w": 6,
    "h": 6
   }
  },
  {
   "id": "w7",
   "definition": {
    "type": "timeseries",
    "title": "CPU time by state (%)",
    "requests": [
     {
      "query": "avg:system.cpu.user{$host,$env,$team}",
      "alias": "user"
     },
     {
      "query": "avg:system.cpu.system{$host,$env,$team}",
      "alias": "system"
     },
     {
      "query": "avg:system.cpu.iowait{$host,$env,$team}",
      "alias": "iowait"
     }
    ],
    "display": "area",
    "stacked": true
   },
   "layout": {
    "x": 6,
    "y": 6,
    "w": 6,
    "h": 6
   }
  },
  {
   "id": "w8",
   "definition": {
    "type": "timeseries",
    "title": "Memory used (GiB) by host",
    "requests": [
     {
      "query": "sum:system.mem.used{$host,$env,$team} by {host}"
     }
    ],
    "display": "area",
    "stacked": true
   },
   "layout": {
    "x": 0,
    "y": 12,
    "w": 6,
    "h": 6
   }
  },
  {
   "id": "w9",
   "definition": {
    "type": "toplist",
    "title": "Top hosts by load (1m)",
    "request": {
     "query": "avg:system.load.1{$host,$env,$team} by {host}"
    },
    "aggregator": "avg",
    "limit": 10
   },
   "layout": {
    "x": 6,
    "y": 12,
    "w": 6,
    "h": 6
   }
  },
  {
   "id": "w10",
   "definition": {
    "type": "timeseries",
    "title": "Network received (B/s)",
    "requests": [
     {
      "query": "sum:system.net.bytes_rcvd{$host,$env,$team} by {host}"
     }
    ],
    "display": "line"
   },
   "layout": {
    "x": 0,
    "y": 18,
    "w": 6,
    "h": 6
   }
  },
  {
   "id": "w11",
   "definition": {
    "type": "timeseries",
    "title": "Network sent (B/s)",
    "requests": [
     {
      "query": "sum:system.net.bytes_sent{$host,$env,$team} by {host}"
     }
    ],
    "display": "line"
   },
   "layout": {
    "x": 6,
    "y": 18,
    "w": 6,
    "h": 6
   }
  },
  {
   "id": "w12",
   "definition": {
    "type": "toplist",
    "title": "Top processes by CPU %",
    "request": {
     "query": "avg:process.cpu.pct{$host,$env,$team} by {host,process}"
    },
    "aggregator": "avg",
    "limit": 10
   },
   "layout": {
    "x": 0,
    "y": 24,
    "w": 6,
    "h": 7
   }
  },
  {
   "id": "w13",
   "definition": {
    "type": "treemap",
    "title": "Process memory (MiB)",
    "request": {
     "query": "sum:process.mem.rss{$host,$env,$team} by {process}"
    },
    "aggregator": "avg"
   },
   "layout": {
    "x": 6,
    "y": 24,
    "w": 6,
    "h": 7
   }
  },
  {
   "id": "w14",
   "definition": {
    "type": "heatmap",
    "title": "CPU user % across hosts",
    "request": {
     "query": "avg:system.cpu.user{$host,$env,$team}"
    }
   },
   "layout": {
    "x": 0,
    "y": 31,
    "w": 12,
    "h": 6
   }
  }
 ]
}
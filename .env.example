# observecraft-server (all optional; defaults match deploy/docker-compose.yml)
OC_HTTP_ADDR=0.0.0.0:8080
OC_CLICKHOUSE_URL=http://localhost:8123
OC_CLICKHOUSE_USER=observecraft
OC_CLICKHOUSE_PASSWORD=observecraft
OC_POSTGRES_URL=postgres://observecraft:observecraft@localhost:5432/observecraft
OC_NATS_URL=nats://localhost:4222
OC_CORS_ORIGINS=http://localhost:5173
# Serve the built web app from the API (production-style); leave empty in dev.
OC_WEB_DIST=
# The install's organization and its first admin (gets a one-time set-password link, logged at startup,
# while nobody can sign in).
OC_DEV_ORG=default
OC_DEV_USER=00000000-0000-0000-0000-000000000001

# ---- authentication
# Encrypts TOTP seeds and OIDC client secrets at rest. REQUIRED in production: a long random string
# (e.g. `openssl rand -base64 48`). Changing it invalidates stored MFA enrollments and OIDC secrets.
OC_SECRET_KEY=
# Origin users open the app on: SSO redirect/ACS URLs and login links are built from it.
OC_PUBLIC_URL=http://localhost:5173
# Set true whenever the app is served over HTTPS.
OC_COOKIE_SECURE=false
# Idle session lifetime in hours (sessions also end 7 days after sign-in).
OC_SESSION_HOURS=12
# Trust X-Forwarded-For for client IPs (only behind your own reverse proxy).
OC_TRUST_PROXY=false
# Demo users, teams and incidents for an empty org (set false in production)
OC_SEED_DEMO=true
RUST_LOG=info,tower_http=info

# web (Vite): "live" talks to the API, "mock" uses the in-browser mocks.
VITE_API_MODE=live

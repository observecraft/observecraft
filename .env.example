# observecraft-server (all optional; defaults match deploy/docker-compose.yml)
OC_HTTP_ADDR=0.0.0.0:8080
OC_CLICKHOUSE_URL=http://localhost:8123
OC_CLICKHOUSE_USER=observecraft
OC_CLICKHOUSE_PASSWORD=observecraft
# ClickHouse cluster to create replicated, sharded tables on (unset: single server).
# OC_CLICKHOUSE_CLUSTER=oc
# Apply migrations at startup (false when a deploy step runs `observecraft-server migrate`).
# OC_RUN_MIGRATIONS=true
# Per-query limits for telemetry reads.
# OC_QUERY_TIMEOUT_SECONDS=60
# OC_QUERY_MAX_MEMORY_BYTES=4294967296
OC_POSTGRES_URL=postgres://observecraft:observecraft@localhost:5432/observecraft
OC_NATS_URL=nats://localhost:4222
# Shared cache (Valkey or another Redis-protocol server), REQUIRED: every server replica keeps shared
# results there. redis://[user:password@]host:6379/0, or rediss://… for TLS. The server exits at
# startup when it is unset or doesn't answer within 30 s.
OC_CACHE_URL=redis://localhost:6379/0
# Values larger than this after compression are served but not stored.
# OC_CACHE_MAX_VALUE_BYTES=8388608
# How long other replicas wait for one replica's load of the same entry before loading themselves.
# OC_CACHE_LOAD_TIMEOUT_SECONDS=30
# Kubernetes objects the in-process inventory cache keeps over all orgs (least recently used orgs go first).
# OC_INVENTORY_CACHE_MAX_OBJECTS=500000
OC_CORS_ORIGINS=http://localhost:5173
# Serve the built web app from the API (production-style); leave empty in dev.
OC_WEB_DIST=
# The install's organization and its first admin (gets a one-time set-password link, logged at startup,
# while nobody can sign in).
OC_DEV_ORG=default
OC_DEV_USER=00000000-0000-0000-0000-000000000001
# Instance administrator: creates, suspends and deletes organizations (Account menu → Instance Admin).
# Becomes an Admin of OC_DEV_ORG; unset, the first admin (OC_DEV_USER) is the instance admin.
OC_INSTANCE_ADMIN_EMAIL=alex.morgan@example.com

# ---- authentication
# Encrypts TOTP seeds and OIDC client secrets at rest. REQUIRED in production: a long random string
# (e.g. `openssl rand -base64 48`). Changing it invalidates stored MFA enrollments and OIDC secrets.
OC_SECRET_KEY=
# Origin users open the app on: SSO redirect/ACS URLs and login links are built from it.
OC_PUBLIC_URL=http://localhost:5173
# Set true whenever the app is served over HTTPS.
OC_COOKIE_SECURE=false
# Idle session lifetime in hours (sessions also end 7 days after sign-in).
OC_SESSION_HOURS=12
# Trust X-Forwarded-For for client IPs (only behind your own reverse proxy).
OC_TRUST_PROXY=false
# Demo users, teams and incidents for an empty org (set false in production)
OC_SEED_DEMO=true
# With OC_SEED_DEMO: an ingest key of the default org used by the local data generators. Local only.
OC_DEMO_INGEST_KEY=ocik_local_demo_only_do_not_use_in_production
# With OC_SEED_DEMO: archive the default org's logs to the local RustFS (docker compose) bucket.
OC_DEMO_ARCHIVE_ENDPOINT=http://localhost:9100
OC_DEMO_ARCHIVE_BUCKET=oc-archives
OC_DEMO_ARCHIVE_ACCESS_KEY=observecraft
OC_DEMO_ARCHIVE_SECRET_KEY=observecraft-archive-dev
# Local working files: archive download cache for Archive Search / rehydration.
OC_DATA_DIR=.oc-data

# ---- retention (logs and spans are per org: Log Indexes / Data Retention; these are defaults and ceilings)
OC_RETENTION_LOGS_DAYS=15
OC_RETENTION_TRACES_DAYS=15
OC_RETENTION_LOGS_MAX_DAYS=365
OC_RETENTION_TRACES_MAX_DAYS=90
OC_RETENTION_METRICS_DAYS=30
OC_RETENTION_CI_DAYS=30
# Every log is kept this long unindexed (archives read it).
OC_RAW_LOGS_HOURS=72

# ---- log indexer (internal; Vector posts every log here)
OC_LOGPROC_ADDR=0.0.0.0:8090
OC_INTERNAL_TOKEN=

# ---- synthetic tests: let them reach loopback, private and link-local addresses (SSRF risk; off by default)
OC_SYNTHETICS_ALLOW_PRIVATE=false

# ---- oc-intake (telemetry gateway; senders use an ingest API key from Organization Settings → API Keys)
OC_INTAKE_ADDR=0.0.0.0:4318
OC_INTAKE_GRPC_ADDR=0.0.0.0:4317
OC_INTAKE_COLLECTOR_URL=http://localhost:14318
OC_INTAKE_LOGS_URL=http://localhost:8687
OC_INTAKE_MAX_BODY_MB=16
OC_INTAKE_ORG_RPS=500
OC_INTAKE_ORG_MBPS=50
RUST_LOG=info,tower_http=info

# web (Vite): "live" talks to the API, "mock" uses the in-browser mocks.
VITE_API_MODE=live
